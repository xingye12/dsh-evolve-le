# Upstream pinned checkouts — tracked as git checkouts inside the repo dir but
# NOT part of this git scope. They are verified read-only by `pnpm upstream:check`.
deepseek-harness/
harbor/
tb/

# Content-addressed external references materialized by setup:source.
.references/

# Dependencies and build output.
node_modules/
**/lib/
**/.tsbuildinfo
**/*.tsbuildinfo

# Evidence and run artifacts (created in later gates).
# Frozen calibration evidence (split commitment, budget model, samples) IS
# tracked — it is a spec-required auditable artifact. Per-run mutable evidence
# stays ignored. Gate acceptance snapshots (gate0) are tracked.
evidence/*
!evidence/calibration/
!evidence/calibration/**
!evidence/gate0/
!evidence/gate0/**
!evidence/gate1/
!evidence/gate1/**
!evidence/gate2/
!evidence/gate2/**
!evidence/gate3/
!evidence/gate3/**
!evidence/pilot/
!evidence/pilot/**
!evidence/formal/
evidence/formal/*
!evidence/formal/STATUS.json
!evidence/gate8/
evidence/gate8/*
!evidence/gate8/STATUS.json
!evidence/gate8/smoke/
!evidence/gate8/smoke/STATUS.json
!evidence/gate8/smoke/real-model-proposal.json
!evidence/gate8/pilot/
evidence/gate8/pilot/*
!evidence/gate8/pilot/STATUS.json
!evidence/gate8/pilot/pilot-run.json
!evidence/gate8/pilot/EVIDENCE.md
!evidence/gate8/pilot/jobs/
!evidence/gate8/pilot/jobs/**
!evidence/gate8/pilot/run/
evidence/gate8/pilot/run/*
!evidence/gate8/pilot/run/*.json
!evidence/gate8/pilot/run/*.jsonl
!evidence/gate8/pilot/run/capsules/
!evidence/gate8/pilot/run/capsules/**
!evidence/gate8/pilot/run/controller/
evidence/gate8/pilot/run/controller/*
!evidence/gate8/pilot/run/controller/sandboxes/
!evidence/gate8/pilot/run/controller/sandboxes/**
# Sandbox capsule staging is bulky and content-addressed in capsules/ +
# objects/ anyway; the proposal audit trail (supervisor, transcript, receipts,
# the children the model wrote) stays tracked.
evidence/gate8/pilot/run/controller/sandboxes/*/input/capsule/
evidence/gate8/pilot/run/controller/sandboxes/*/input/capsule/**
!evidence/gate4/
evidence/gate4/*
!evidence/gate4/STATUS.json
!evidence/gate4/proposal-e2e.json
!evidence/gate5/
evidence/gate5/*
!evidence/gate5/STATUS.json
!evidence/gate5/cli-e2e.json
