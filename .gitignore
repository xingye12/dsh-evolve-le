!evidence/gate7/sbom.spdx.json
runs/

# Editor / OS noise.
.DS_Store
*.log

# Harbor trial/job logs inside tracked gate evidence are audit artifacts
# (rule 7: failed trials stay, with their logs), not editor noise.
!evidence/gate2/**/*.log
!evidence/gate6/jobs/**/*.log
!evidence/gate8/pilot/jobs/**/*.log

# ZCode session/plan artifacts (not part of the project).
.zcode/

# Gate 7 release artifacts (content-addressed into evidence/gate7 instead).
release/
