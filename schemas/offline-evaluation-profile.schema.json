{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "totalUsdMicros",
    "totalWallSeconds",
    "maxInputBytes",
    "requestTimeoutMs",
    "perCaseCalls",
    "perCaseTokens",
    "perCaseUsdMicros",
    "bootstrapSamples",
    "plan",
    "sourceIdentity"
  ],
  "properties": {
    "methods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["single-pass", "v4"] }
    },
    "runId": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,100}$" },
    "totalUsdMicros": { "type": "integer", "minimum": 1 },
    "totalWallSeconds": { "type": "integer", "minimum": 1 },
    "maxInputBytes": { "type": "integer", "minimum": 8192, "maximum": 1048576 },
    "requestTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 600000 },
    "perCaseCalls": { "type": "integer", "minimum": 1, "maximum": 64 },
    "perCaseTokens": { "type": "integer", "minimum": 1 },
    "perCaseUsdMicros": { "type": "integer", "minimum": 1 },
    "bootstrapSamples": { "type": "integer", "minimum": 100, "maximum": 100000 },
    "sourceIdentity": { "type": "object", "additionalProperties": { "type": "string" } },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routeId",
        "baseUrl",
        "model",
        "temperature",
        "maxOutputTokens",
        "inputUsdPerMTok",
        "outputUsdPerMTok",
        "retry"
      ],
      "properties": {
        "routeId": { "type": "string", "minLength": 1 },
        "baseUrl": { "type": "string", "pattern": "^https?://[^@]+$" },
        "model": { "type": "string", "minLength": 1 },
        "temperature": { "const": 0 },
        "maxOutputTokens": { "type": "integer", "minimum": 1, "maximum": 131072 },
        "inputUsdPerMTok": { "type": "number", "exclusiveMinimum": 0 },
        "outputUsdPerMTok": { "type": "number", "exclusiveMinimum": 0 },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxAttempts", "backoffMs"],
          "properties": {
            "maxAttempts": { "const": 1 },
            "backoffMs": { "type": "array", "maxItems": 0 }
          }
        }
      }
    }
  }
}
