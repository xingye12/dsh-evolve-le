{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-evolve-le.local/schema/tree-v2/capability-catalog/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocol",
    "kind",
    "candidateDigest",
    "capabilities",
    "receiptDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "protocol": { "const": "dsh-self-evolving-candidate-tree-v2" },
    "kind": { "const": "capability-catalog" },
    "candidateDigest": { "$ref": "#/$defs/digest" },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "receiptDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
