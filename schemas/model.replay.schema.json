{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dsh-evolve-le.local/schemas/model.replay.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "provider", "model", "responses"],
  "properties": {
    "protocol": {
      "const": "dsh-evolve-le/model-replay/v1"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["responseText", "promptTokens", "completionTokens"],
        "properties": {
          "responseText": {
            "type": "string"
          },
          "promptTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "completionTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "toolCalls": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "arguments"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "arguments": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
