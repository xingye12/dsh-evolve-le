{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-evolve-le.local/schema/tree-v2/mechanism-outcome/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocol",
    "kind",
    "candidateIntentDigest",
    "mechanismTestDigest",
    "outcome",
    "receiptDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "protocol": { "const": "dsh-self-evolving-candidate-tree-v2" },
    "kind": { "const": "mechanism-outcome" },
    "candidateIntentDigest": { "$ref": "#/$defs/digest" },
    "mechanismTestDigest": { "$ref": "#/$defs/digest" },
    "outcome": { "enum": ["passed", "failed"] },
    "receiptDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
