{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dsh-evolve-le.local/schemas/proposal.test.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "specDigest",
        "child",
        "source",
        "parentSnapshot",
        "parentCapsuleInventory",
        "workerInventory",
        "dependencyClosureSha256",
        "profile"
      ],
      "properties": {
        "protocol": {
          "const": "dsh-evolve-le/proposal-test-intent/v1"
        },
        "specDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "child": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "source": {
          "$ref": "#/definitions/objectRef"
        },
        "parentSnapshot": {
          "$ref": "#/definitions/objectRef"
        },
        "parentCapsuleInventory": {
          "$ref": "#/definitions/objectRef"
        },
        "workerInventory": {
          "$ref": "#/definitions/objectRef"
        },
        "dependencyClosureSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "profile": {
          "type": "object"
        },
        "treeV2ParentEvidence": {
          "type": "object"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "specDigest", "child", "source", "plan", "aggregate", "ok"],
      "properties": {
        "protocol": {
          "const": "dsh-evolve-le/proposal-test-result/v1"
        },
        "specDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "child": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "source": {
          "$ref": "#/definitions/objectRef"
        },
        "plan": {
          "$ref": "#/definitions/objectRef"
        },
        "aggregate": {
          "$ref": "#/definitions/objectRef"
        },
        "ok": {
          "type": "boolean"
        }
      }
    }
  ],
  "definitions": {
    "objectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "size", "mediaType", "label"],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "enum": ["PUBLIC_SPEC", "DEV_OBSERVED", "DEV_GUARD", "SEALED", "CONTROLLER_INTERNAL"]
        }
      }
    }
  }
}
