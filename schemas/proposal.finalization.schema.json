{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dsh-evolve-le.local/schemas/proposal.finalization.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "sources", "specDigest", "inputManifest", "proposal"],
      "properties": {
        "protocol": {
          "const": "dsh-evolve-le/proposal-finalization-intent/v1"
        },
        "sources": {
          "type": "array",
          "maxItems": 3,
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/source"
          }
        },
        "specDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inputManifest": {
          "$ref": "#/definitions/objectRef"
        },
        "proposal": {
          "type": "object"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "sources", "intent", "proposal"],
      "properties": {
        "protocol": {
          "const": "dsh-evolve-le/proposal-finalization-result/v1"
        },
        "sources": {
          "type": "array",
          "maxItems": 3,
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/source"
          }
        },
        "intent": {
          "$ref": "#/definitions/objectRef"
        },
        "proposal": {
          "type": "object"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "sources", "intent", "reason"],
      "properties": {
        "protocol": {
          "const": "dsh-evolve-le/proposal-finalization-failure/v1"
        },
        "sources": {
          "type": "array",
          "maxItems": 3,
          "minItems": 0,
          "items": {
            "$ref": "#/definitions/source"
          }
        },
        "intent": {
          "$ref": "#/definitions/objectRef"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    }
  ],
  "definitions": {
    "objectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "size", "mediaType", "label"],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "enum": ["PUBLIC_SPEC", "DEV_OBSERVED", "DEV_GUARD", "SEALED", "CONTROLLER_INTERNAL"]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["child", "source"],
      "properties": {
        "child": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "source": {
          "$ref": "#/definitions/objectRef"
        }
      }
    }
  }
}
