{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-evolve-le.local/schemas/build.manifest.schema.json",
  "title": "dsh-evolve-le build manifest",
  "description": "Trusted-builder output for one candidate admission attempt (specs/02 §6, §11). Every field here is computed by the builder; the proposer cannot author any of it. Only a manifest whose receipts are all `pass` admits a candidate as ADMITTED_UNEVALUATED. Timestamps live only in this file, never inside the hashed source/bundle/capsule artifacts, so double-build hashes stay equal.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://dsh-evolve-le.local/schemas/build.manifest.schema.json"
    },
    "schemaVersion": { "type": "integer", "const": 1 },
    "candidateId": { "$ref": "#/$defs/candidateId" },
    "outcome": {
      "enum": ["admitted", "rejected"],
      "description": "Admitted means pipeline stages 1-10 all passed; admission is safety-runnability, never performance acceptance."
    },
    "rejection": {
      "type": "object",
      "properties": {
        "stage": { "$ref": "#/$defs/stageName" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "required": ["stage", "reason"],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "sourceDigest": { "$ref": "#/$defs/sha256Ref" },
        "canonicalParent": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256Ref" }]
        }
      },
      "required": ["sourceDigest", "canonicalParent"],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "fileCount": { "type": "integer", "minimum": 1, "maximum": 25 },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "treeDigest": { "$ref": "#/$defs/treeDigest" }
      },
      "required": ["fileCount", "bytes", "treeDigest"],
      "additionalProperties": false
    },
    "bundle": {
      "type": "object",
      "properties": {
        "tarSha256": { "$ref": "#/$defs/sha256Hex" },
        "entrySha256": { "$ref": "#/$defs/sha256Hex" },
        "fileCount": { "type": "integer", "minimum": 1 },
        "bytes": { "type": "integer", "minimum": 1 }
      },
      "required": ["tarSha256", "entrySha256", "fileCount", "bytes"],
      "additionalProperties": false
    },
    "capsule": {
      "type": "object",
      "properties": {
        "tarSha256": { "$ref": "#/$defs/sha256Hex" },
        "sbomSha256": { "$ref": "#/$defs/sha256Hex" },
        "provenanceSha256": { "$ref": "#/$defs/sha256Hex" }
      },
      "required": ["tarSha256", "sbomSha256", "provenanceSha256"],
      "additionalProperties": false
    },
    "parentDiff": {
      "type": "object",
      "properties": {
        "parent": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256Ref" }]
        },
        "diffHash": { "$ref": "#/$defs/sha256Hex" },
        "filesChanged": { "type": "integer", "minimum": 0 },
        "linesAdded": { "type": "integer", "minimum": 0 },
        "linesRemoved": { "type": "integer", "minimum": 0 }
      },
      "required": ["parent", "diffHash", "filesChanged", "linesAdded", "linesRemoved"],
      "additionalProperties": false
    },
    "fingerprints": {
      "type": "object",
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "pnpm": { "type": "string", "minLength": 1 },
        "typescript": { "type": "string", "minLength": 1 },
        "dependencyClosureSha256": { "$ref": "#/$defs/sha256Hex" },
        "tsconfigSha256": {
          "$ref": "#/$defs/sha256Hex",
          "description": "Hash of the builder-generated effective tsconfig; the candidate's own tsconfig.json is identity material only and never executed."
        }
      },
      "required": ["node", "pnpm", "typescript", "dependencyClosureSha256", "tsconfigSha256"],
      "additionalProperties": false
    },
    "receipts": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/stageName" },
      "additionalProperties": { "$ref": "#/$defs/receipt" },
      "minProperties": 10,
      "maxProperties": 10
    },
    "builder": {
      "type": "object",
      "properties": {
        "builtAt": { "type": "string", "format": "date-time" },
        "sandbox": {
          "type": "object",
          "properties": {
            "kind": { "enum": ["container", "namespace", "host-restricted"] },
            "detail": { "type": "string", "minLength": 1 }
          },
          "required": ["kind", "detail"],
          "additionalProperties": false
        },
        "networkAccess": { "const": false },
        "executedCandidateLifecycleScript": { "const": false }
      },
      "required": ["builtAt", "sandbox", "networkAccess", "executedCandidateLifecycleScript"],
      "additionalProperties": false
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "candidateId",
    "outcome",
    "identity",
    "receipts",
    "builder"
  ],
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "rejected" } } },
      "then": {
        "required": ["rejection"],
        "properties": { "rejection": { "$ref": "#/$defs/rejection" } }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "admitted" } } },
      "then": {
        "required": ["source", "bundle", "capsule", "parentDiff", "fingerprints"],
        "properties": {
          "source": true,
          "bundle": true,
          "capsule": true,
          "parentDiff": true,
          "fingerprints": true,
          "rejection": false
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "rejection": {
      "type": "object",
      "properties": {
        "stage": { "$ref": "#/$defs/stageName" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "required": ["stage", "reason"],
      "additionalProperties": false
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256Ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^c_[a-z2-7]{26}$"
    },
    "treeDigest": {
      "type": "object",
      "properties": {
        "algo": { "const": "dsh-evolve-tree-v1" },
        "value": { "$ref": "#/$defs/sha256Hex" }
      },
      "required": ["algo", "value"],
      "additionalProperties": false
    },
    "stageName": {
      "enum": [
        "containment",
        "schema",
        "diffBoundary",
        "policyScan",
        "reproducibleBuild",
        "typeLintUnit",
        "loaderBoot",
        "unloadInvariant",
        "mockReplay",
        "capsuleDoubleBuild"
      ]
    },
    "receipt": {
      "type": "object",
      "properties": {
        "status": { "enum": ["pass", "fail", "skipped"] },
        "detail": { "type": "string", "minLength": 1 },
        "artifact": {
          "type": "string",
          "pattern": "^evidence://[A-Za-z0-9._/-]+$"
        }
      },
      "required": ["status", "detail"],
      "additionalProperties": false
    }
  }
}
