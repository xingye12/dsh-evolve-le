{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "objectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "size", "mediaType", "label"],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "enum": ["PUBLIC_SPEC", "DEV_OBSERVED", "DEV_GUARD", "SEALED", "CONTROLLER_INTERNAL"]
        }
      }
    }
  },
  "$id": "https://dsh-evolve-le.local/schemas/execution.completion.schema.json",
  "required": ["protocol", "execution", "receipts"],
  "properties": {
    "protocol": {
      "const": "dsh-evolve-le/execution-completion/v1"
    },
    "execution": {
      "$ref": "#/definitions/objectRef"
    },
    "receipts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 65536,
      "items": {
        "$ref": "#/definitions/objectRef"
      }
    }
  }
}
