{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "objectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "size", "mediaType", "label"],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "enum": ["PUBLIC_SPEC", "DEV_OBSERVED", "DEV_GUARD", "SEALED", "CONTROLLER_INTERNAL"]
        }
      }
    }
  },
  "$id": "https://dsh-evolve-le.local/schemas/proposal.generation-result.schema.json",
  "required": [
    "protocol",
    "admission",
    "outcome",
    "specDigest",
    "execution",
    "completion",
    "submission",
    "diagnostic"
  ],
  "properties": {
    "protocol": {
      "const": "dsh-evolve-le/proposal-generation-result/v1"
    },
    "admission": {
      "const": "NONE"
    },
    "outcome": {
      "enum": ["SUCCEEDED", "FAILED", "CANCELLED", "INCOMPLETE"]
    },
    "specDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "execution": {
      "anyOf": [
        {
          "$ref": "#/definitions/objectRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "completion": {
      "anyOf": [
        {
          "$ref": "#/definitions/objectRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "submission": {
      "anyOf": [
        {
          "$ref": "#/definitions/objectRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostic": {
      "anyOf": [
        {
          "$ref": "#/definitions/objectRef"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "SUCCEEDED"
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "$ref": "#/definitions/objectRef"
          },
          "completion": {
            "$ref": "#/definitions/objectRef"
          },
          "submission": {
            "$ref": "#/definitions/objectRef"
          }
        }
      },
      "else": {
        "properties": {
          "submission": {
            "type": "null"
          },
          "diagnostic": {
            "$ref": "#/definitions/objectRef"
          }
        }
      }
    }
  ]
}
