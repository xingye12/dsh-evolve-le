{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "objectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "size", "mediaType", "label"],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "enum": ["PUBLIC_SPEC", "DEV_OBSERVED", "DEV_GUARD", "SEALED", "CONTROLLER_INTERNAL"]
        }
      }
    }
  },
  "$id": "https://dsh-evolve-le.local/schemas/proposal.supervisor-result.schema.json",
  "required": ["protocol", "outcome", "execution", "completion", "submission"],
  "properties": {
    "protocol": {
      "const": "dsh-evolve-le/proposal-supervisor-result/v2"
    },
    "outcome": {
      "enum": ["SUCCEEDED", "FAILED", "CANCELLED", "INCOMPLETE"]
    },
    "execution": {
      "$ref": "#/definitions/objectRef"
    },
    "completion": {
      "$ref": "#/definitions/objectRef"
    },
    "submission": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/objectRef"
        }
      ]
    }
  }
}
