{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dsh-evolve-le.local/schemas/source-snapshot.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "executionId", "specDigest", "child", "files", "totalBytes"],
  "properties": {
    "protocol": {
      "const": "dsh-evolve-le/source-snapshot/v1"
    },
    "executionId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
    },
    "specDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "child": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mode", "content"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "mode": {
            "enum": [420, 493]
          },
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": ["algorithm", "digest", "size", "mediaType", "label"],
            "properties": {
              "algorithm": {
                "const": "sha256"
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "mediaType": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "enum": [
                  "PUBLIC_SPEC",
                  "DEV_OBSERVED",
                  "DEV_GUARD",
                  "SEALED",
                  "CONTROLLER_INTERNAL"
                ]
              }
            }
          }
        }
      },
      "minItems": 1,
      "maxItems": 65536
    },
    "totalBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
