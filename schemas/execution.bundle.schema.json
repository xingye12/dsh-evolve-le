{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dsh-evolve-le.local/schemas/execution.bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "spec", "receipts", "artifacts", "outcome"],
  "properties": {
    "protocol": {
      "const": "dsh-evolve-le/execution-bundle/v1"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "size", "mediaType", "label"],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "enum": ["PUBLIC_SPEC", "DEV_OBSERVED", "DEV_GUARD", "SEALED", "CONTROLLER_INTERNAL"]
        }
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["algorithm", "digest", "size", "mediaType", "label"],
        "properties": {
          "algorithm": {
            "const": "sha256"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "enum": ["PUBLIC_SPEC", "DEV_OBSERVED", "DEV_GUARD", "SEALED", "CONTROLLER_INTERNAL"]
          }
        }
      },
      "minItems": 1,
      "maxItems": 65536
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["algorithm", "digest", "size", "mediaType", "label"],
        "properties": {
          "algorithm": {
            "const": "sha256"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "enum": ["PUBLIC_SPEC", "DEV_OBSERVED", "DEV_GUARD", "SEALED", "CONTROLLER_INTERNAL"]
          }
        }
      },
      "minItems": 0,
      "maxItems": 65536
    },
    "outcome": {
      "enum": ["SUCCEEDED", "FAILED", "CANCELLED", "INCOMPLETE"]
    },
    "failureReason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  }
}
