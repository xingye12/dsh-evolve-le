{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dsh-evolve-le.local/schemas/model.ledger.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "executionId", "provider", "model", "limits"],
  "properties": {
    "protocol": {
      "const": "dsh-evolve-le/model-ledger/v1"
    },
    "executionId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxRequests",
        "maxInputTokens",
        "maxOutputTokens",
        "maxTotalTokens",
        "maxCostUsdMicros",
        "maxRequestBytes",
        "inputUsdMicrosPerMillion",
        "outputUsdMicrosPerMillion"
      ],
      "properties": {
        "maxRequests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxInputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxTotalTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxCostUsdMicros": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxRequestBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inputUsdMicrosPerMillion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputUsdMicrosPerMillion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
